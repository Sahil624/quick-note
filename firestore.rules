rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function willBeOwner() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Notes + diagrams
    match /artifacts/{artifactId} {
      allow read: if isOwner();
      allow create: if willBeOwner()
        && request.resource.data.type in ['note', 'diagram'];
      allow update, delete: if isOwner();
    }

    // Folders
    match /folders/{folderId} {
      allow read: if isOwner();
      allow create: if willBeOwner();
      allow update, delete: if isOwner();
    }

    // Public share copies (anyone can read; create when signed in or sharing local notes)
    match /publicNotes/{publicId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
